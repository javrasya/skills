{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Workflow scripts are function bodies (top-level `return`), so they do not parse as modules.
    "includes": ["src/**", "bin/**", "test/**", "scripts/**", "!test/fixtures/crew-run/*.workflow.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Biome's ceiling. The code keeps whole statements on one line and the
    // longest run past 200 columns, so anything lower would rewrap them.
    "lineWidth": 320
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Terse arrows sequence two effects with a comma on purpose.
        "noCommaOperator": "off",
        // Test regexes match screen rows, whose column gaps are literal runs of spaces.
        "noAdjacentSpacesInRegex": "off"
      },
      "correctness": {
        // Callbacks name every positional parameter, the skipped ones too, so the signature reads as the caller's.
        "noUnusedFunctionParameters": "off"
      },
      "style": {
        // Concatenation stays where it reads better than a template.
        "useTemplate": "off"
      },
      "suspicious": {
        // `x ??= ...` inside an expression is how a shared promise is made once, lazily.
        "noAssignInExpressions": "off",
        // A catch normalises a thrown non-Error into one, in place.
        "noCatchAssign": "off",
        // Terminal input and output is parsed with regexes over escape bytes.
        "noControlCharactersInRegex": "off",
        // The one deliberate fall-through (journal.mjs) carries a `// falls through` comment Biome does not read.
        "noFallthroughSwitchClause": "off",
        // Strings that mention `${` are messages and fixtures about interpolation, not templates.
        "noTemplateCurlyInString": "off"
      }
    }
  }
}
