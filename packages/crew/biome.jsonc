{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Workflow scripts are function bodies (top-level `return`), so they do not parse as modules.
    "includes": ["src/**", "bin/**", "test/**", "scripts/**", "!test/fixtures/crew-run/*.workflow.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Biome's ceiling. The code keeps whole statements on one line and the
    // longest run past 200 columns, so anything lower would rewrap them.
    "lineWidth": 320
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
